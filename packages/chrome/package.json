{
  "name": "tabmark-chrome",
  "private": true,
  "version": "0.0.0",
  "description": "Chrome extension to view Tabmark (*.table.md) as a read-only grid on GitHub",
  "scripts": {
    "build": "esbuild src/content/index.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/content.js",
    "dev": "esbuild src/content/index.ts --bundle --format=iife --sourcemap --target=es2020 --outfile=dist/content.js --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tabmark-core": "^0.1.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.1.3",
    "vitest": "^1.0.0"
  }
}


